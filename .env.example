# Baza (lokalno: docker compose up -d)
DATABASE_URL="postgresql://eestec:eestec@localhost:5433/events"

# Auth0 (Regular Web Application, Google konekcija)
AUTH0_DOMAIN="YOUR_TENANT.eu.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# openssl rand -hex 32  (šifruje sesiju i služi za HMAC ključeva ograničenja brzine)
AUTH0_SECRET=""
# Javni URL aplikacije, bez završne kose crte
APP_BASE_URL="http://localhost:3000"

# Jedini email koji ima admin pristup (mora biti verifikovan Google identitet)
ADMIN_EMAIL="hr@eestec-sa.ba"

# SAMO za lokalni razvoj i testove: simulirana prijava preko /dev-login.
# U produkciji se ignoriše (uz upozorenje u logu). NIKAD ne postavljati na Vercelu.
DEV_AUTH="false"
