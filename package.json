{
  "name": "eestec-events",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-all.mjs",
    "migrate": "prisma migrate deploy",
    "start": "next start",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:unit": "node --test test/unit.test.mjs test/roles.test.mjs test/actions-guard.test.mjs",
    "sheets:build": "npm --prefix sheets/web run build",
    "sheets:test": "node --test sheets/test/backend.test.mjs sheets/test/migration.test.mjs sheets/test/admins.test.mjs sheets/test/legal.test.mjs sheets/test/e2e.test.mjs",
    "sheets:dev": "node sheets/scripts/dev-server.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.33.0",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
